# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase → Connect, or Project Settings → API Keys). Both are safe to be public.
# Never put the service_role / secret key or the database password here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
